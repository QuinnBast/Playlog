{
  "uid": "steam-sessions",
  "title": "Steam sessions",
  "description": "Every Steam session in the selected range on one timeline.",
  "tags": [
    "steam",
    "games"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "links": [
    {
      "title": "Steam playtime",
      "type": "link",
      "url": "/d/steam-playtime",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "asDropdown": false,
      "tags": [],
      "tooltip": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "account",
        "label": "Account",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "steam-playtime"
        },
        "query": "SELECT display_name FROM accounts UNION SELECT account FROM v_lifetime_totals UNION SELECT account FROM v_playtime ORDER BY 1",
        "definition": "SELECT display_name FROM accounts UNION SELECT account FROM v_lifetime_totals UNION SELECT account FROM v_playtime ORDER BY 1",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 20,
      "type": "state-timeline",
      "title": "Every session",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "steam-playtime"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 32
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "steam-playtime"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT t.time, t.row, t.value FROM v_sessions s CROSS JOIN LATERAL (VALUES (s.started_at, s.game || ' \u00b7 ' || s.account || ' \u00b7 ' || s.device, s.account || '|' || to_char(s.seconds / 3600.0, 'FM990.0') || ' h'), (s.ended_at, s.game || ' \u00b7 ' || s.account || ' \u00b7 ' || s.device, NULL)) AS t (time, row, value) WHERE $__timeFilter(s.started_at) AND s.account IN ($account) AND s.seconds >= 60 ORDER BY t.row, t.time"
        }
      ],
      "description": "Each bar is one session: its row says what was played, by whom and on which device; its length is how long. Drag across the chart to zoom in.",
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "row"
            ],
            "keepFields": false,
            "naming": {
              "asLabels": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.row}",
          "color": {
            "mode": "fixed",
            "fixedColor": "#d95926"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "spanNulls": false,
            "insertNulls": false
          },
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": "^Quinn\\|(.*)$",
                "result": {
                  "text": "$1",
                  "color": "#3987e5",
                  "index": 0
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^[^|]*\\|(.*)$",
                "result": {
                  "text": "$1",
                  "color": "#d95926",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": false,
        "showValue": "never",
        "alignValue": "center",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    }
  ]
}