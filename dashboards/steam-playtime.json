          "rawQuery": true,
          "rawSql": "WITH top AS (SELECT app_id FROM v_playtime WHERE $__timeFilter(at) AND account IN ($account) GROUP BY app_id ORDER BY sum(seconds) DESC LIMIT 15) SELECT p.game, p.account, round(sum(p.seconds) / 3600.0, 1) AS hours FROM v_playtime p JOIN top USING (app_id) WHERE $__timeFilter(p.at) AND p.account IN ($account) GROUP BY 1, 2"
