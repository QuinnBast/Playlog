          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "barAlignment": -1,
            "barWidthFactor": 0.8,
            "fillOpacity": 85,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "axisSoftMin": 0,
