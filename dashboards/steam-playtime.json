          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('$bucket', at AT TIME ZONE (SELECT timezone FROM settings)) AT TIME ZONE (SELECT timezone FROM settings) AS time, device AS metric, round(sum(seconds) / 3600.0, 2) AS value FROM v_playtime WHERE $__timeFilter(at) AND account IN ($account) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
