    {
      "id": 11,
      "type": "barchart",
      "title": "Average hours played per weekday",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "steam-playtime"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "steam-playtime"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH days AS (SELECT d::date AS day FROM generate_series(($__timeFrom() AT TIME ZONE (SELECT timezone FROM settings))::date, ($__timeTo() AT TIME ZONE (SELECT timezone FROM settings))::date, interval '1 day') d), accounts AS (SELECT DISTINCT account FROM v_sessions WHERE account IN ($account) AND $__timeFilter(started_at)), played AS (SELECT * FROM v_session_hours WHERE $__timeFilter(hour) AND account IN ($account)), weekdays AS (SELECT EXTRACT(ISODOW FROM day)::int AS dow, count(*) AS n FROM days GROUP BY 1) SELECT w.label AS bucket, a.account, COALESCE(sum(p.seconds), 0) / 3600.0 / n.n AS value FROM (VALUES (1, 'Mon'), (2, 'Tue'), (3, 'Wed'), (4, 'Thu'), (5, 'Fri'), (6, 'Sat'), (7, 'Sun')) AS w (dow, label) JOIN weekdays n ON n.dow = w.dow CROSS JOIN accounts a LEFT JOIN played p ON EXTRACT(ISODOW FROM p.local_hour) = w.dow AND p.account = a.account GROUP BY w.dow, w.label, a.account, n.n ORDER BY w.dow, a.account"
        }
      ],
      "description": "Tracked hours on each weekday, averaged over every such day in the range (days without play count as 0).",
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "account",
            "rowField": "bucket",
            "valueField": "value",
            "emptyValue": "zero"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "bucket\\account": "Day"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#d95926"
          },
          "unit": "suffix: h",
          "decimals": 1,
          "min": 0,
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Quinn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Day"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      },
