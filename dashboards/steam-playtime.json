{
  "uid": "steam-playtime",
  "title": "Steam playtime",
  "description": "Every recorded Steam session, every account and device (github.com/QuinnBast/Playlog).",
  "tags": [
    "steam",
    "games"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "links": [
    {
      "title": "All sessions (timeline)",
      "type": "link",
      "url": "/d/steam-sessions",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "asDropdown": false,
      "tags": [],
      "tooltip": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "account",
        "label": "Account",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "steam-playtime"
        },
        "query": "SELECT display_name FROM accounts UNION SELECT account FROM v_lifetime_totals UNION SELECT account FROM v_playtime ORDER BY 1",
        "definition": "SELECT display_name FROM accounts UNION SELECT account FROM v_lifetime_totals UNION SELECT account FROM v_playtime ORDER BY 1",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "bucket",
        "label": "Group by",
        "type": "custom",
        "query": "day,week,month",
        "current": {
          "text": "day",
          "value": "day"
        },
        "options": [
          {
            "text": "day",
            "value": "day",
            "selected": true
          },
          {
            "text": "week",
            "value": "week",
            "selected": false
          },
          {
            "text": "month",
            "value": "month",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Hours played",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "steam-playtime"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "steam-playtime"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(round(sum(seconds) / 3600.0, 1), 0) AS hours FROM v_playtime WHERE $__timeFilter(at) AND account IN ($account)"
        }
      ],
      "description": "Tracked sessions plus untracked time (\"other\": Steam counted it, no agent recorded it).",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: h",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
