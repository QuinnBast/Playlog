        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Current streak",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "steam-playtime"
      },
      "gridPos": {
        "x": 11,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "steam-playtime"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH days AS (SELECT DISTINCT (at AT TIME ZONE (SELECT timezone FROM settings))::date AS d FROM v_playtime WHERE tracked AND account IN ($account)), g AS (SELECT d, d - (row_number() OVER (ORDER BY d))::int AS grp FROM days) SELECT CASE WHEN max(d) >= (now() AT TIME ZONE (SELECT timezone FROM settings))::date - 1 THEN count(*) ELSE 0 END FROM g WHERE grp = (SELECT grp FROM g ORDER BY d DESC LIMIT 1)"
        }
      ],
      "description": "Consecutive days with a tracked session, up to today or yesterday.",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:  days",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Longest streak",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "steam-playtime"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "steam-playtime"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH days AS (SELECT DISTINCT (at AT TIME ZONE (SELECT timezone FROM settings))::date AS d FROM v_playtime WHERE tracked AND account IN ($account)), g AS (SELECT d, d - (row_number() OVER (ORDER BY d))::int AS grp FROM days) SELECT COALESCE(max(c), 0) FROM (SELECT count(*) AS c FROM g GROUP BY grp) s"
        }
      ],
      "description": "All time, not just the selected range.",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:  days",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Now playing",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "steam-playtime"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "steam-playtime"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(string_agg(COALESCE(a.display_name, d.current_account_id::text) || ': ' || COALESCE(g.name, 'App ' || d.current_app_id) || ' (' || d.name || ')', ' \u00b7 '), 'Nothing') AS now FROM devices d LEFT JOIN accounts a ON a.account_id = d.current_account_id LEFT JOIN games g ON g.app_id = d.current_app_id WHERE d.current_app_id IS NOT NULL AND d.last_seen_at > now() - interval '3 minutes'"
        }
      ],
      "description": "Live from the agents (updated every minute while the device can reach the server).",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 26
        }
      }
    },
    {
      "id": 7,
      "type": "heatmap",
      "title": "Days played",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "steam-playtime"
      },
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "steam-playtime"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT w.week AT TIME ZONE (SELECT timezone FROM settings) AS time, round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(ISODOW FROM s.local_hour) = 7), 0) / 3600.0, 2) AS \"Sun\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(ISODOW FROM s.local_hour) = 6), 0) / 3600.0, 2) AS \"Sat\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(ISODOW FROM s.local_hour) = 5), 0) / 3600.0, 2) AS \"Fri\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(ISODOW FROM s.local_hour) = 4), 0) / 3600.0, 2) AS \"Thu\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(ISODOW FROM s.local_hour) = 3), 0) / 3600.0, 2) AS \"Wed\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(ISODOW FROM s.local_hour) = 2), 0) / 3600.0, 2) AS \"Tue\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(ISODOW FROM s.local_hour) = 1), 0) / 3600.0, 2) AS \"Mon\" FROM generate_series(date_trunc('week', $__timeFrom() AT TIME ZONE (SELECT timezone FROM settings)), $__timeTo() AT TIME ZONE (SELECT timezone FROM settings), interval '1 week') AS w (week) LEFT JOIN v_session_hours s ON date_trunc('week', s.local_hour) = w.week AND $__timeFilter(s.hour) AND s.account IN ($account) GROUP BY w.week ORDER BY w.week"
        }
      ],
      "description": "Hours of tracked play per day over the last year, one column per week (like GitHub's contribution graph). Not limited by the time range.",
      "timeFrom": "1y",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: h",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 2,
        "cellValues": {
          "unit": "suffix: h",
          "decimals": 1
        },
        "color": {
          "mode": "opacity",
          "fill": "#39d353",
          "scale": "exponential",
          "exponent": 0.6,
          "min": 0,
          "steps": 64
        },
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false
        },
        "rowsFrame": {
          "layout": "unknown"
        },
        "showValue": "never",
        "legend": {
          "show": true
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": false,
          "showColorScale": false
        },
        "exemplars": {
          "color": "transparent"
        },
        "filterValues": {
          "le": 0.01
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Total hours by weekday \u00d7 hour of day",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "steam-playtime"
      },
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "steam-playtime"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT d.label AS \"Day\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 0), 0) / 3600.0, 1) AS \"00\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 1), 0) / 3600.0, 1) AS \"01\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 2), 0) / 3600.0, 1) AS \"02\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 3), 0) / 3600.0, 1) AS \"03\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 4), 0) / 3600.0, 1) AS \"04\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 5), 0) / 3600.0, 1) AS \"05\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 6), 0) / 3600.0, 1) AS \"06\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 7), 0) / 3600.0, 1) AS \"07\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 8), 0) / 3600.0, 1) AS \"08\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 9), 0) / 3600.0, 1) AS \"09\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 10), 0) / 3600.0, 1) AS \"10\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 11), 0) / 3600.0, 1) AS \"11\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 12), 0) / 3600.0, 1) AS \"12\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 13), 0) / 3600.0, 1) AS \"13\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 14), 0) / 3600.0, 1) AS \"14\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 15), 0) / 3600.0, 1) AS \"15\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 16), 0) / 3600.0, 1) AS \"16\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 17), 0) / 3600.0, 1) AS \"17\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 18), 0) / 3600.0, 1) AS \"18\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 19), 0) / 3600.0, 1) AS \"19\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 20), 0) / 3600.0, 1) AS \"20\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 21), 0) / 3600.0, 1) AS \"21\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 22), 0) / 3600.0, 1) AS \"22\", round(COALESCE(sum(s.seconds) FILTER (WHERE EXTRACT(HOUR FROM s.local_hour) = 23), 0) / 3600.0, 1) AS \"23\" FROM (VALUES (1, 'Mon'), (2, 'Tue'), (3, 'Wed'), (4, 'Thu'), (5, 'Fri'), (6, 'Sat'), (7, 'Sun')) AS d (dow, label) LEFT JOIN v_session_hours s ON EXTRACT(ISODOW FROM s.local_hour) = d.dow AND $__timeFilter(s.hour) AND s.account IN ($account) GROUP BY d.dow, d.label ORDER BY d.dow"
        }
      ],
      "description": "Each cell: total hours of tracked play in that clock hour (local time) on that weekday, added up over the whole selected range - e.g. Thu / 21 = all play between 21:00 and 22:00 on every Thursday in the range. A session counts in every hour it covers.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "continuous-greens"
          },
          "custom": {
            "align": "center",
            "minWidth": 40,
            "cellOptions": {
              "type": "color-background",
              "mode": "gradient"
            }
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": " "
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Day"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Hours per $bucket by account",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "steam-playtime"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "steam-playtime"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('$bucket', at AT TIME ZONE (SELECT timezone FROM settings)) AT TIME ZONE (SELECT timezone FROM settings) AS time, account AS metric, round(sum(seconds) / 3600.0, 2) AS value FROM v_playtime WHERE $__timeFilter(at) AND account IN ($account) GROUP BY 1, 2 ORDER BY 1"
        }
