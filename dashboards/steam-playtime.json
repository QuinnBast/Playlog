    {
      "id": 3,
      "type": "stat",
      "title": "Longest session",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "steam-playtime"
      },
      "gridPos": {
        "x": 7,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "steam-playtime"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(max(seconds), 0) / 3600.0 FROM v_sessions WHERE $__timeFilter(started_at) AND account IN ($account)"
        }
      ],
      "fieldConfig": {
