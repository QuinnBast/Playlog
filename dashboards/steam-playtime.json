      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Hours per $bucket by device",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "steam-playtime"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
